# One file per seller instance: /etc/proofpay-mvp/seller-<id>.env
# systemd: proofpay-seller@<id>.service  ->  EnvironmentFile=/etc/proofpay-mvp/seller-%i.env
# chmod 640, owner root:proofpay. Copy for each seller and adjust.

SELLER_ID=scout
# "partial" = deliberately delivers only one of three promised cart checks (dispute demo).
# "general" = full delivery for all capabilities. Cart audits always use HTTP checks.
SELLER_MODE=general
SELLER_PORT=3083
SELLER_TOKEN_FILE=/etc/proofpay-mvp/scout.token
MARKET_INTERNAL_URL=http://127.0.0.1:3070
LUXAI_KEY_FILE=/etc/proofpay-mvp/luxai.key
# LUXAI_URL=https://api.lux-ai.cz/v1/chat/completions
