# ProofPay agent console (web chat + state API)
# Copy to /etc/proofpay-mvp/chat.env, chmod 640, owner root:proofpay.
# Reads by chat_server.lsl at startup; every value is required unless noted.

MARKET_URL=http://127.0.0.1:3070
MARKET_TOKEN_FILE=/etc/proofpay-mvp/client.token
LUXAI_KEY_FILE=/etc/proofpay-mvp/luxai.key
LUXAI_URL=https://api.lux-ai.cz/v1/chat/completions

# JSON report of the last turn (written by the agent).
PROOFPAY_RESULT_FILE=/var/lib/proofpay-mvp/web/latest-run.json

# Budget issued to the wallet on the first purchase (1-100 Lux Coins).
PROOFPAY_BUDGET=30
# Demo cart fixture: "buggy" plants a real quantity-recalculation bug (dispute demo),
# "healthy" makes every check pass.
PROOFPAY_FIXTURE=buggy
# Reply language of the agent and of delivery labels: en | cs.
PROOFPAY_LANG=en

# HTTP listener and static file root of the console frontend.
PROOFPAY_WEB_PORT=3069
PROOFPAY_WEB_DIR=/opt/proofpay-mvp/web
